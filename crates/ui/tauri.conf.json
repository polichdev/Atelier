{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Atelier",
  "version": "0.1.0",
  "identifier": "com.atelier.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atelier Theme Studio",
        "width": 940,
        "height": 660,
        "minWidth": 640,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "windowEffects": { "effects": ["micaDark"] }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
